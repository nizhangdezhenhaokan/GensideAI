```env
# 由 bun run env:examples 自动生成，请勿手动修改。
# 这是 BrowserOS Monorepo 根目录使用的开发环境变量示例文件。
# 使用时复制为 .env.development；真正的 .env.development 已被 Git 忽略，不会提交。

# --- 开发工具 ---

# CDP 协议 JSON 文件路径，用于生成 Chrome DevTools Protocol 相关代码。
# CDP_PROTOCOL_JSON=/path/to/chromium/src/out/Default_arm64/gen/third_party/blink/public/devtools_protocol/protocol.json

# App 和 Claw 开发时使用的 BrowserOS 浏览器可执行文件路径。
BROWSEROS_BINARY=/Applications/BrowserOS.app/Contents/MacOS/BrowserOS


# --- BrowserOS App ---

# BrowserOS App 开发时使用的 Chromium 远程调试（CDP）端口。
BROWSEROS_CDP_PORT=9005

# BrowserOS Server 服务端口，同时也会作为 Claw 启动浏览器时使用的服务端口。
BROWSEROS_SERVER_PORT=9105

# BrowserOS Extension 开发服务器端口。
BROWSEROS_EXTENSION_PORT=9305

# BrowserOS 浏览器前端使用的 PostHog 项目 Key，用于产品行为统计。
VITE_PUBLIC_POSTHOG_KEY=

# BrowserOS 浏览器前端使用的 PostHog 服务地址。
VITE_PUBLIC_POSTHOG_HOST=

# BrowserOS 浏览器前端使用的 Sentry DSN，用于前端异常和错误上报。
VITE_PUBLIC_SENTRY_DSN=

# 暴露给 BrowserOS 浏览器前端使用的 BrowserOS API 地址。
VITE_PUBLIC_BROWSEROS_API=https://api.browseros.com

# BrowserOS 浏览器前端 Alpha 功能开关。
VITE_ALPHA_FEATURES=true

# 可选的 GraphQL Schema 文件路径。
# 如果没有配置，则默认使用 schema/schema.graphql。
# GRAPHQL_SCHEMA_PATH=/path/to/api-repo/.../schema.graphql

# Sentry 认证 Token，用于上传 Source Map。
SENTRY_AUTH_TOKEN=

# Sentry Organization 名称，用于 Source Map 上传。
SENTRY_ORG=

# Sentry Project 名称，用于 Source Map 上传。
SENTRY_PROJECT=


# --- Claw / BrowserOS neo ---

# 可选的 Claw API 基础地址。
# dev:claw 开发流程通常会由 tools/dev 自动注入；
# 如果这里显式配置，则环境变量中的值优先。
# VITE_BROWSEROS_CLAW_API_URL=http://127.0.0.1:9200

# 可选的 Chromium User Data Directory。
# 用于指定 Claw 开发时启动浏览器所使用的用户数据目录。
# BROWSEROS_USER_DATA_DIR=/tmp/my-browseros-dev

# 可选的 Claw Chromium 远程调试端口。
# Claw App 和 Claw Server 开发环境共用。
# BROWSEROS_CLAW_CDP_PORT=49337

# 可选的 BrowserClaw 状态数据根目录。
# BROWSERCLAW_DIR=~/.browserclaw-dev

# Claw Server 使用的 PostHog Project Key。
# Production 构建时必须配置。
CLAW_POSTHOG_KEY=

# 可选的 Claw Server PostHog 服务地址。
# 默认使用 PostHog US Cloud。
# CLAW_POSTHOG_HOST=https://us.i.posthog.com

# BrowserClaw 客户端 Bundle 中嵌入的 PostHog Project Key。
# Production 构建时必须配置。
VITE_CLAW_POSTHOG_KEY=

# 可选的 BrowserClaw 前端 PostHog 服务地址。
# 默认使用 PostHog US Cloud。
# VITE_CLAW_POSTHOG_HOST=https://us.i.posthog.com


# --- BrowserOS Server ---

# BrowserOS Server 配置服务 URL。
# Production 构建时必须配置。
BROWSEROS_CONFIG_URL=https://llm.browseros.com/api/browseros-server/config

# 本地 BrowserOS Server 开发时允许访问服务的可信 Origin。
BROWSEROS_TRUSTED_ORIGINS=

# BrowserOS Server Telemetry / PostHog Key。
# CLI Release 构建也使用同一个 Key。
POSTHOG_API_KEY=

# BrowserOS Server 使用的 Sentry DSN，用于服务端异常上报。
SENTRY_DSN=

# Node/Bun 运行环境。
# development 表示开发环境。
NODE_ENV=development

# BrowserOS Server 日志级别。
LOG_LEVEL=info

# 可选：是否开启 AI SDK DevTools 数据采集。
# 主要用于本地 Server 调试。
# BROWSEROS_AI_SDK_DEVTOOLS=true

# BrowserOS Server 测试时是否使用无头浏览器。
# true 表示测试时浏览器不显示 GUI。
BROWSEROS_TEST_HEADLESS=true
```
