```env
# 由 bun run env:examples 自动生成，请勿手动修改。
# 这是 BrowserOS Monorepo 根目录使用的生产环境变量示例文件。
# 使用时复制为 .env.production；真正的 .env.production 已被 Git 忽略，不会提交。


# --- Claw / BrowserOS neo ---

# Claw Server 使用的 PostHog 项目 Key。
# Production 构建时必须配置。
CLAW_POSTHOG_KEY=

# 可选：Claw Server 使用的 PostHog 服务地址。
# 默认使用 PostHog US Cloud。
# CLAW_POSTHOG_HOST=https://us.i.posthog.com

# BrowserClaw 客户端 Bundle 中嵌入的 PostHog 项目 Key。
# Production 构建时必须配置。
VITE_CLAW_POSTHOG_KEY=

# 可选：BrowserClaw 前端 Bundle 使用的 PostHog 服务地址。
# 默认使用 PostHog US Cloud。
# VITE_CLAW_POSTHOG_HOST=https://us.i.posthog.com


# --- BrowserOS Server ---

# BrowserOS Server 配置服务 URL。
# Production 构建时必须配置。
BROWSEROS_CONFIG_URL=https://llm.browseros.com/api/browseros-server/config

# BrowserOS Server Telemetry / PostHog Key。
# CLI Release 构建也会读取同一个 Key。
POSTHOG_API_KEY=

# BrowserOS Server 使用的 Sentry DSN。
# 用于服务端异常和错误上报。
SENTRY_DSN=

# Server 和构建脚本运行环境。
# production 表示生产环境。
NODE_ENV=production

# BrowserOS Server 日志级别。
LOG_LEVEL=info


# --- 构建产物上传 ---

# Cloudflare R2 账户 ID。
# 用于上传正式发布的构建产物。
R2_ACCOUNT_ID=

# Cloudflare R2 Access Key ID。
# 用于生产构建产物上传认证。
R2_ACCESS_KEY_ID=

# Cloudflare R2 Secret Access Key。
# 用于生产构建产物上传认证。
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 存储桶名称。
# 正式构建产物会上传到该 Bucket。
R2_BUCKET=browseros


# --- Windows 代码签名 ---

# BrowserOS Windows 正式构建使用的 eSigner 用户名。
ESIGNER_USERNAME=

# BrowserOS Windows 正式构建使用的 eSigner 密码。
ESIGNER_PASSWORD=

# BrowserOS Windows 正式签名使用的 TOTP 二次验证密钥。
ESIGNER_TOTP_SECRET=

# BrowserOS Windows 正式签名使用的证书 / 凭据 ID。
ESIGNER_CREDENTIAL_ID=
```
